---
import type { SignalKey } from '../../lib/signal';
import { signalBg, signalText } from '../../lib/signal-style';

interface Props {
  label: string;
  value: string;
  signal?: SignalKey;
  sub?: string;
}
const { label, value, signal = 'neutral', sub } = Astro.props;
---
<div class={`not-prose border rounded-2xl p-4 flex flex-col gap-1 ${signalBg[signal]}`}>
  <div class="text-[10px] sm:text-xs text-muted uppercase tracking-widest truncate">{label}</div>
  <div class={`text-2xl sm:text-3xl font-bold ${signalText[signal]}`}>{value}</div>
  {sub && <div class="text-xs text-muted">{sub}</div>}
</div>
